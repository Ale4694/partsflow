# Copy to .env and adjust. Placeholders only: never commit a real .env.
POSTGRES_DB=partsflow
POSTGRES_USER=partsflow
POSTGRES_PASSWORD=change-me

# Used by the app when run outside Docker: export these (the app does not read .env itself).
# They must match the POSTGRES_* values above. If unset, application.yml uses local dev defaults.
DB_URL=jdbc:postgresql://localhost:5432/partsflow
DB_USER=partsflow
DB_PASSWORD=change-me

# Host port of the web interface (docker compose up serves it on http://localhost:8081).
WEB_PORT=8081

# LLM settings (README, "Choosing the LLM provider"). The key is read only from the environment. Without it
# (or with an incomplete configuration) the AI endpoints return 503 and everything else works.
LLM_API_KEY=

# The next three are OPTIONAL: leave them commented out unless you change provider (an EMPTY value overrides the
# defaults, an absent one does not).
# LLM_PROVIDER=gemini            # gemini (default) or openai-compatible
# LLM_BASE_URL=https://api.example.com/v1   # openai-compatible only: the address of the service, with /v1
# LLM_MODEL=model-name           # Gemini default: gemini-3.5-flash; openai-compatible: required
